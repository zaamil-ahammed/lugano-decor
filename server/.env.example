# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/diecast for local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/diecast

# Long random string used to sign admin login tokens. Change this!
JWT_SECRET=change-this-to-a-long-random-string

# Admin login for the /admin panel. Change both before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Default WhatsApp number (country code + number, digits only). Editable later in the admin panel.
WHATSAPP_NUMBER=919447650667

# Where the website runs (comma separated). Use * while testing locally.
CORS_ORIGIN=http://localhost:5173

PORT=5000

# Photo storage. Leave empty in development: photos are saved in server/uploads.
# On Render's free plan the disk is wiped on every restart, so set this when you deploy:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
